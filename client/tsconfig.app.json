{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Deliberately off. It would require every optional field on a DTO to be
    // written as `string | undefined` at each call site; the API's optional
    // fields are genuinely absent, not "present and undefined".
    "exactOptionalPropertyTypes": false,

    // Also off: it types every index access as possibly-undefined, which would
    // add noise to array mapping without catching a real bug in this codebase.
    "noUncheckedIndexedAccess": false,

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"]
}
