{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=QualityControlDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },

  "Database": {
    "MigrateOnStartup": true
  },

  "Jwt": {
    "Issuer": "QualityControl.API",
    "Audience": "QualityControl.Client"

    // Key is deliberately absent. A signing key committed to source control is a
    // published credential: anyone holding it can mint a valid administrator token.
    // Supply it out of band — see README, "Настройка секретов":
    //   dotnet user-secrets set "Jwt:Key" "<32+ random characters>"
    // or the Jwt__Key environment variable in production.
    // Startup fails with a clear message if it is missing.
  },

  "Auth": {
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "PasswordResetTokenLifetimeMinutes": 30,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 8,
    "ClientBaseUrl": "http://localhost:5173"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "DefectPhotosFolder": "defects",
    "MaxPhotoSizeBytes": 10485760,
    "MaxPhotosPerDefect": 20,
    "AllowedPhotoContentTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "AllowedPhotoExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },

  "Email": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 25,
    "UseSsl": false,
    "FromAddress": "otk@amkodor-pinsk.by",
    "FromDisplayName": "АСКК «Амкодор-Пинск»"
  },

  "PdfExport": {
    "FontFamily": "Segoe UI",
    "OrganisationName": "ОАО «Амкодор-Пинск»",
    "SystemName": "Автоматизированная система контроля качества продукции"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
