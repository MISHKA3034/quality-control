{
  // Development overrides. Secrets still do not belong here — this file is
  // committed. Use `dotnet user-secrets` for Jwt:Key and the seed passwords.

  "Seed": {
    // Loads a year of demo batches, inspections, defects and corrective actions
    // so the dashboard has something to show on a fresh database.
    "DemoData": true

    // Passwords for the seeded accounts are read from user-secrets:
    //   dotnet user-secrets set "Seed:AdministratorPassword" "<password>"
    //   dotnet user-secrets set "Seed:DemoUserPassword" "<password>"
    // Without them the accounts are skipped and a warning is logged.
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",

        // Set to Information to see the generated SQL while debugging a query.
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
